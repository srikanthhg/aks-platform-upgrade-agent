APP_ENVIRONMENT=development
AUTH_MODE=api_key
APP_API_KEY=local-development-only
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aks_upgrade_agent
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_REQUIRED_ROLE=AKS.Upgrade.Operator
AZURE_AUTH_MODE=existing
AZURE_SUBSCRIPTION_ID=
AZURE_MANAGED_IDENTITY_CLIENT_ID=
ALLOW_REAL_UPGRADES=false
DEFAULT_DRY_RUN=true
AI_ADVISOR_ENABLED=true
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# Azure deployment name for a GPT-4.1-class chat model; not the model family label.
AZURE_OPENAI_DEPLOYMENT=gpt-41-aks-advisor
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional for local development only. Prefer managed identity / Entra ID in Azure.
AZURE_OPENAI_API_KEY=
TEAMS_NOTIFICATIONS_ENABLED=false
TEAMS_WEBHOOK_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
REPORTS_DIRECTORY=/tmp/aks-agent/reports
KUBECONFIG_DIRECTORY=/tmp/aks-agent/kubeconfigs
